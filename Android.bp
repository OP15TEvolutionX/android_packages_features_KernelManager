// SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["evolution_kernel_manager_license"],
}
license {
    name: "evolution_kernel_manager_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["LICENSE"],
}
filegroup {
    name: "evolution-kernel-manager-common-srcs",
    srcs: ["common/src/**/*.java"],
    visibility: ["//frameworks/base/core/java:__pkg__"],
}
filegroup {
    name: "evolution-kernel-manager-server-srcs",
    srcs: ["server/src/**/*.java"],
    visibility: ["//frameworks/base/services/core:__pkg__"],
}
filegroup {
    name: "evolution-kernel-manager-settings-srcs",
    srcs: ["settings/src/**/*.kt"],
    visibility: ["//packages/apps/Settings:__pkg__"],
}
